            paymentSubmitValidationInFlight = true;
            const submitter = event.submitter instanceof HTMLElement ? event.submitter : null;
            const submitAction = submitter?.dataset.paymentAction || submitter?.getAttribute('value') || 'save-payment';

            try {
                if (submitAction !== 'save-payment' && submitAction !== 'save') {
