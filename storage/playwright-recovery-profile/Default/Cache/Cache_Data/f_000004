        paymentPrintReceiptButton.dataset.paymentPrintUrl = nextUrl;
    };

    const ensureExchangeSettlementTargetsReady = async () => {
        if (!currentInvoiceNeedsSettlementTarget() || hasCurrentInvoiceSettlementTarget()) {
