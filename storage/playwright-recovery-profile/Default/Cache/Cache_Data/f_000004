            paymentNoPreviousBalance.hidden = visibleBalances.length !== 0;
        }

        return {
            invoiceCurrency,
            previousBalanceInInvoiceCurrency: previousBalanceAmount,
            openBalanceInInvoiceCurrency: Math.max(toNumber(openBalanceMap[invoiceCurrency] || 0), 0),
            openBalanceMap,
