APP_ENV=production
APP_DEBUG=false
APP_NAME="Travel Agency Operations"
APP_URL=https://your-production-domain.example
APP_KEY=base64:REPLACE_WITH_A_REAL_32_BYTE_BASE64_KEY
APP_TIMEZONE=Asia/Karachi

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_production_user
DB_PASSWORD=replace_with_strong_database_password
DB_CHARSET=utf8mb4
MYSQLDUMP_PATH=/home/example/bin/mysqldump

PASSWORD_RESET_DELIVERY_MODE=disabled
TWO_FACTOR_TEMPORARILY_DISABLED=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
TRUSTED_DEVICE_COOKIE_SECURE=true
TRUSTED_DEVICE_COOKIE_SAMESITE=Lax
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
HEALTH_CHECK_TOKEN=replace_with_long_random_health_check_token
LAUNCHER_GATE_ENABLED=true
LAUNCHER_GATE_HEADER=X-Travel-Launcher-Token
LAUNCHER_GATE_SIGNATURE_ENABLED=true
LAUNCHER_GATE_ALLOW_LEGACY_TOKEN=false
LAUNCHER_GATE_KEY_ID=travel-launcher-1
LAUNCHER_GATE_PUBLIC_KEY_PATH=storage/keys/launcher_gate_public.pem
LAUNCHER_GATE_SIGNATURE_HEADER=X-Travel-Launcher-Signature
LAUNCHER_GATE_TIMESTAMP_HEADER=X-Travel-Launcher-Timestamp
LAUNCHER_GATE_NONCE_HEADER=X-Travel-Launcher-Nonce
LAUNCHER_GATE_KEY_ID_HEADER=X-Travel-Launcher-Key-Id
LAUNCHER_GATE_SIGNATURE_TTL_SECONDS=90
# Optional only if you deliberately re-enable a temporary fallback:
# LAUNCHER_GATE_TOKEN=replace_with_long_random_launcher_token
PASSWORD_HASH_DRIVER=argon2id
PASSWORD_ARGON_MEMORY_COST=65536
PASSWORD_ARGON_TIME_COST=4
PASSWORD_ARGON_THREADS=2
